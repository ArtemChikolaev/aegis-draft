# Go
/pipeline/aegis-build
/pipeline/data/raw/
/pipeline/data/normalized/
/pipeline/data/aggregate/
*.exe

# Node / Vite
node_modules/
/web/dist/
.vite/

# Данные web/public/data/*.json версионируются: deploy берёт закоммиченный датасет, а workflow
# data-refresh (крон) пересобирает его пайплайном (--emit-domain). Мок `npm run gen:mock` по
# умолчанию пишет сюда, а не поверх боевого датасета (тесты читают его через AEGIS_DATA_DIR).
/web/.mock-data/

# Env / secrets (ключи OpenDota, контакты Liquipedia UA)
.env
.env.local
api_keys.txt

# Claude Code: настройки конкретной машины (общие для проекта — .claude/settings.json)
/.claude/settings.local.json

# OS / editor
.DS_Store
.idea/
.vscode/

# Playwright: артефакты прогонов — из web/ или из корня, если тест запущен не оттуда
test-results/
playwright-report/
blob-report/

# Черновики агентских QA-прогонов и разовых проверок в любом каталоге (web/.tmp_*, web/scripts/.tmp_*)
**/.tmp_*

# Python skill validation
__pycache__/
