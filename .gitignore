*.exe

# Node / Vite
node_modules/
/web/dist/
.vite/

# Данные web/public/data/*.json теперь версионируются: deploy берёт закоммиченный
# датасет, а workflow data-refresh (крон) пересобирает его пайплайном (--emit-domain).
# gen:mock перегенерирует мок локально/в CI-проверках.

# Env / secrets (ключи OpenDota, контакты Liquipedia UA)
.env
.env.local
api_keys.txt

# OS / editor
.DS_Store
.idea/
.vscode/

# Playwright
/web/test-results/
/web/playwright-report/
/web/blob-report/

# Playwright: артефакты прогонов (в т.ч. из корня, если тест запущен не из web/)
test-results/
web/test-results/
web/playwright-report/

# Черновики агентских QA-прогонов (playwright-скрипты в рабочем дереве web/)
web/.tmp_*
