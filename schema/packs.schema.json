{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "aegis-draft/packs.schema.json",
  "title": "Packs (Team Packs)",
  "type": "array",
  "items": {
    "type": "object",
    "required": ["id", "eventId", "teamId", "teamName", "formats", "players", "signatureHeroes"],
    "additionalProperties": false,
    "properties": {
      "id": { "type": "string", "description": "{eventId}-{teamId}" },
      "eventId": { "type": "string" },
      "teamId": { "type": "integer" },
      "teamName": { "type": "string" },
      "tag": { "type": "string" },
      "logoUrl": {
        "type": "string",
        "format": "uri",
        "description": "Логотип команды (OpenDota logo_url, CDN Steam). Необязательный: у части исторических команд логотипа нет вовсе — UI обязан иметь фолбэк. Пришёл на место мёртвого logoId, который не заполнялся ни разу."
      },
      "placement": { "type": "integer", "description": "Место на турнире" },
      "formats": {
        "type": "array",
        "minItems": 1,
        "description": "Окна, в которых пак доступен: подмножество formats события после гейта присутствия команды (минимум 2 события окна). У́же, чем у события: команда бывает постоянной в last_5y и разовой в last_1y. Пул строится по этому полю, а не по formats события.",
        "items": { "type": "string", "enum": ["last_1y", "last_2y", "last_5y", "valve_legacy"] }
      },
      "players": {
        "type": "array",
        "minItems": 5,
        "items": { "$ref": "#/definitions/packPlayer" }
      },
      "signatureHeroes": {
        "type": "array",
        "items": { "type": "integer", "description": "hero_id" }
      }
    }
  },
  "definitions": {
    "packPlayer": {
      "type": "object",
      "required": ["accountId", "nickname", "role", "ovr", "impact", "economy", "reliability", "games"],
      "additionalProperties": false,
      "properties": {
        "accountId": { "type": "integer", "description": "Канонический OpenDota account_id" },
        "nickname": { "type": "string" },
        "role": { "type": "string", "enum": ["safelane", "mid", "offlane", "support"] },
        "ovr": { "type": "integer", "minimum": 0, "maximum": 100 },
        "impact": { "type": "integer", "minimum": 0, "maximum": 100 },
        "economy": { "type": "integer", "minimum": 0, "maximum": 100 },
        "reliability": { "type": "integer", "minimum": 0, "maximum": 100 },
        "games": { "type": "integer", "minimum": 0, "description": "Игр на этом событии (уверенность рейтинга)" }
      }
    }
  }
}
